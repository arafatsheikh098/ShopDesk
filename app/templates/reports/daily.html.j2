{% extends "base.html.j2" %}
{% block title %}Daily Report — ShopDesk{% endblock %}
{% block content %}
<div class="page-header">
  <div>
    <div class="breadcrumbs"><a href="/reports/daily">Reports</a> <span>/</span> Daily Summary</div>
    <h1>Daily Report — {{ day }}</h1>
    <p>Financial snapshot, payment method distribution, and top selling products</p>
  </div>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a class="btn" href="/reports/monthly">📅 Monthly Report</a>
    <a class="btn secondary" href="/reports/dues">📋 Customer Dues</a>
    <a class="btn secondary" href="/reports/export.csv">⬇ Export CSV</a>
  </div>
</div>

<!-- Key Performance Indicators -->
<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-icon primary">🧾</div>
    <div class="stat-content">
      <div class="stat-label">Sales: <b>{{ report.sales_count }}</b></div>
      <div class="stat-value">{{ report.sales_count }}</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon success">💰</div>
    <div class="stat-content">
      <div class="stat-label">Total: <b>{{ report.total }}</b></div>
      <div class="stat-value">৳{{ (report.total / 100)|round(2) if report.total is number else report.total }}</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon success">📈</div>
    <div class="stat-content">
      <div class="stat-label"><b>Profit: {{ report.profit }}</b></div>
      <div class="stat-value">৳{{ (report.profit / 100)|round(2) if report.profit is number else report.profit }}</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon warning">⏳</div>
    <div class="stat-content">
      <div class="stat-label">Outstanding (today): {{ report.outstanding }}</div>
      <div class="stat-value">৳{{ (report.outstanding / 100)|round(2) if report.outstanding is number else report.outstanding }}</div>
    </div>
  </div>
</div>

<!-- Secondary Metrics Bar -->
<div class="card" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
  <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: 0.9rem;">
    <div>Subtotal: <strong>৳{{ (report.subtotal / 100)|round(2) if report.subtotal is number else report.subtotal }}</strong></div>
    <div>Discount: <strong>৳{{ (report.discount / 100)|round(2) if report.discount is number else report.discount }}</strong></div>
    <div>Cost: <strong>৳{{ (report.cost_total / 100)|round(2) if report.cost_total is number else report.cost_total }}</strong></div>
  </div>
</div>

<div class="grid-2col">
  <!-- Payment Method Breakdown -->
  <div class="card">
    <div class="card-header">
      <h2>By Payment Method</h2>
      <span class="badge badge-info">Breakdown</span>
    </div>
    <table class="table-compact">
      <thead>
        <tr><th>Method</th><th>Amount</th></tr>
      </thead>
      <tbody>
        {% for k, v in report.by_method.items() %}
        <tr>
          <td style="font-weight: 600;">
            {% if k == 'cash' %}💵 Cash
            {% elif k == 'mobile_wallet' %}📱 Mobile Wallet
            {% elif k == 'due' %}📋 Due / Credit
            {% else %}{{ k }}
            {% endif %}
          </td>
          <td style="font-family: var(--font-mono); font-weight: 700;">
            ৳{{ (v / 100)|round(2) if v is number else v }}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Top Products Leaderboard -->
  <div class="card">
    <div class="card-header">
      <h2>Top Products</h2>
      <span class="badge badge-success">Best Sellers</span>
    </div>
    <table class="table-compact">
      <thead>
        <tr><th>Rank & Product</th><th>Quantity Sold</th></tr>
      </thead>
      <tbody>
        {% for p in report.top_products %}
        <tr>
          <td>
            {% if loop.index == 1 %}🥇
            {% elif loop.index == 2 %}🥈
            {% elif loop.index == 3 %}🥉
            {% else %}#{{ loop.index }}
            {% endif %}
            <strong style="margin-left: 0.35rem;">{{ p.name }}</strong>
          </td>
          <td style="font-family: var(--font-mono); font-weight: 700;">
            <span class="badge">{{ p.quantity }}</span>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="2" style="text-align: center; color: var(--text-muted); padding: 2rem;">
            No sales recorded yet for this date.
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}