{% extends "base.html.j2" %}
{% block title %}Low stock — ShopDesk{% endblock %}
{% block content %}
<div class="page-header">
  <div>
    <div class="breadcrumbs"><a href="/stock">Stock</a> <span>/</span> Low stock alerts</div>
    <h1>Low stock alerts</h1>
    <p>Items currently at or below their minimum reorder threshold</p>
  </div>
  <div>
    <a href="/stock" class="btn secondary">All stock</a>
  </div>
</div>

<div class="alert alert-warning" style="margin-bottom: 1.25rem;">
  <svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
  <span>Found <strong>{{ products|length }}</strong> items needing restock attention.</span>
</div>

<div class="table-responsive">
  <table>
    <thead>
      <tr>
        <th>SKU</th>
        <th>Name</th>
        <th>On hand</th>
        <th>Threshold</th>
      </tr>
    </thead>
    <tbody>
      {% for p in products %}
      <tr>
        <td><code>{{ p.sku }}</code></td>
        <td style="font-weight: 700;">{{ p.name }}</td>
        <td>
          <span class="badge badge-danger">{{ p.stock }} {{ p.unit }}</span>
        </td>
        <td style="font-family: var(--font-mono); color: var(--text-muted);">{{ p.low_stock_threshold }}</td>
      </tr>
      {% else %}
      <tr>
        <td colspan="4" style="text-align: center; padding: 3rem; color: var(--text-muted);">
          All inventory levels are healthy! No low stock items.
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}