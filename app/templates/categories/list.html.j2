{% extends "base.html.j2" %}
{% block title %}Categories — ShopDesk{% endblock %}
{% block content %}
<h1>Categories</h1>
{% if user and user.role.value == 'owner' %}
<form method="post" action="/categories" autocomplete="off">
  <p><label>Name<br><input name="name" required></label>
     <button class="btn" type="submit">Add</button></p>
</form>
{% endif %}
<table>
<tr><th>Name</th>{% if user and user.role.value == 'owner' %}<th></th>{% endif %}</tr>
{% for c in categories %}
<tr>
  <td>{{ c.name }}</td>
  {% if user and user.role.value == 'owner' %}
  <td>
    <form method="post" action="/categories/{{ c.id }}/delete" style="display:inline">
      <button class="btn danger" type="submit" onclick="return confirm('Delete?')">Delete</button>
    </form>
  </td>
  {% endif %}
</tr>
{% endfor %}
</table>
{% endblock %}