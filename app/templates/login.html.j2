{% extends "base.html.j2" %}
{% block title %}Sign in — ShopDesk{% endblock %}
{% block content %}
<h1>Sign in</h1>
{% if error %}<p style="color:#b00020">{{ error }}</p>{% endif %}
<form method="post" action="/login" autocomplete="off">
  <p><label>Username<br><input name="username" required autofocus></label></p>
  <p><label>Password<br><input name="password" type="password" required></label></p>
  <p><button class="btn" type="submit">Sign in</button></p>
</form>
{% endblock %}
