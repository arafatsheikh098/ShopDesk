{% extends "base.html.j2" %}
{% block title %}POS Register — ShopDesk{% endblock %}
{% block content %}
<div class="page-header" style="margin-bottom: 1rem;">
  <div>
    <h1>Point of Sale</h1>
    <p>Barcode scanner ready (USB) • Tap products to add • Offline synced</p>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <button type="button" id="pos-sound-toggle" class="btn secondary btn-sm" title="Toggle audio chime">
      🔊 Sound ON
    </button>
  </div>
</div>

<div id="pos-app"
     data-csrf="{{ csrf_token }}"
     data-products='{{ products|tojson }}'>

  <!-- Left: Catalog & Search Pane -->
  <div class="pos-catalog-pane">
    <div class="row">
      <div class="pos-search-hero">
        <label for="barcode">Barcode Scanner / Search Product</label>
        <div style="position: relative;">
          <svg class="pos-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
            <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
            <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
            <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            <rect x="7" y="7" width="3" height="10"></rect>
            <rect x="14" y="7" width="3" height="10"></rect>
          </svg>
          <input id="barcode" autocomplete="off" autofocus placeholder="Scan barcode or type name/SKU...">
          <span class="barcode-badge-hint">Enter ↵</span>
        </div>
      </div>
      <div>
        <label>Customer (for due or receipt)</label>
        <div style="display: flex; gap: 0.5rem;">
          <input id="customer-name" placeholder="Name">
          <input id="customer-phone" placeholder="Phone">
        </div>
      </div>
    </div>

    <!-- Category Filter Chips -->
    <div class="category-chips-bar" id="category-chips">
      <button type="button" class="category-chip active" data-cat="all">All Items</button>
    </div>

    <!-- Quick Touch Product Grid -->
    <div class="product-grid" id="product-grid">
      <!-- Injected by index.js -->
    </div>
  </div>

  <!-- Right: Digital Register & Checkout Pane -->
  <div class="pos-register-pane">
    <div class="cart-card">
      <div class="cart-header">
        <h2>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          Current Order
        </h2>
        <span id="cart-item-count" class="badge">0 items</span>
      </div>

      <div class="table-responsive" style="margin: 0; max-height: 280px; overflow-y: auto;">
        <table id="cart">
          <thead>
            <tr>
              <th>Item</th>
              <th style="width: 70px;">Qty</th>
              <th>Unit</th>
              <th>Total</th>
              <th style="width: 40px;"></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>

      <div id="cart-empty-state" style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 0.5rem; opacity: 0.5;">
          <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <p style="margin: 0; font-size: 0.9rem; font-weight: 500;">Cart is empty</p>
        <span style="font-size: 0.8rem;">Scan a barcode or tap products from the catalog</span>
      </div>

      <div class="totals">
        <div>
          <span>Subtotal:</span>
          <span>৳<span id="subtotal">0</span></span>
        </div>
        
        <div>
          <span>Discount:</span>
          <div style="display:flex; gap:0.35rem; align-items:center;">
            <select id="discount-kind" style="width:auto; padding:0.35rem 0.5rem; font-size:0.85rem;">
              <option value="none">none</option>
              <option value="percent">percent %</option>
              <option value="amount">amount</option>
            </select>
            <input id="discount-value" type="number" min="0" value="0" style="width:75px; padding:0.35rem 0.5rem; font-size:0.85rem; font-family:var(--font-mono);">
          </div>
        </div>

        <div style="display:flex; gap:0.25rem; justify-content:flex-end;">
          <button type="button" class="btn secondary btn-sm discount-quick-chip" data-pct="0">0%</button>
          <button type="button" class="btn secondary btn-sm discount-quick-chip" data-pct="5">5%</button>
          <button type="button" class="btn secondary btn-sm discount-quick-chip" data-pct="10">10%</button>
          <button type="button" class="btn secondary btn-sm discount-quick-chip" data-pct="15">15%</button>
        </div>

        <div class="totals-highlight-row">
          <span>Total Payable:</span>
          <span style="display:flex; align-items:baseline; gap:0.2rem;">
            <span style="font-size:1.1rem; color:var(--brand-primary); font-weight:800;">৳</span>
            <span id="total">0</span>
          </span>
        </div>

        <div>
          <span>Payment:</span>
          <select id="payment-method" style="width:auto; padding:0.4rem 0.6rem; font-size:0.85rem;">
            <option value="cash">Cash 💵</option>
            <option value="mobile_wallet">Mobile Wallet 📱</option>
            <option value="due">Due / Credit 📋</option>
          </select>
        </div>

        <div>
          <span>Amount Paid:</span>
          <div style="display:flex; align-items:center; gap:0.35rem;">
            <span style="font-family:var(--font-mono); font-size:0.85rem;">৳</span>
            <input id="paid" type="number" min="0" value="0" style="width:110px; padding:0.4rem 0.6rem; font-family:var(--font-mono); font-weight:700;">
          </div>
        </div>

        <div class="quick-tenders-bar">
          <button type="button" class="quick-tender-chip" id="tender-exact">Exact</button>
          <button type="button" class="quick-tender-chip" data-add="50">+50</button>
          <button type="button" class="quick-tender-chip" data-add="100">+100</button>
          <button type="button" class="quick-tender-chip" data-add="500">+500</button>
          <button type="button" class="quick-tender-chip" data-add="1000">+1000</button>
        </div>

        <button id="finish" class="btn">
          <span>Complete Sale</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
        <span id="msg"></span>
      </div>
    </div>

    <!-- Recent Sales Drawer -->
    <div class="recent-sales-box">
      <h3 style="margin-top:0; display:flex; align-items:center; gap:0.5rem;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
        Recent Sales & Invoices
      </h3>
      <div class="recent-sales-search">
        <input id="sale-search" placeholder="Enter sale # (e.g. 20261018-0001)">
        <button id="search-sale" class="btn secondary">Find</button>
      </div>
      <div id="sale-result" style="display:none;"></div>
    </div>
  </div>
</div>

<script type="module" src="/static/js/pos/offline.js"></script>
<script type="module" src="/static/js/pos/index.js"></script>
{% endblock %}