<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}ShopDesk{% endblock %}</title>
<link rel="stylesheet" href="/static/css/style.css">
{% block extrahead %}{% endblock %}
</head>
<body>
<header>
  <div>
    <strong>ShopDesk</strong>
    <a href="/pos">POS</a>
    <a href="/products">Products</a>
    <a href="/stock">Stock</a>
    <a href="/reports/daily">Reports</a>
    <a href="/settings">Settings</a>
    <span id="pending-badge" class="badge pending-badge">Pending: 0</span>
  </div>
  <div>
    {% if user %}
      <span class="user-badge">👤 {{ user.username }} ({{ user.role.value }})</span>
      <a href="/logout" class="btn secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">Logout</a>
    {% endif %}
  </div>
</header>
<main>
  {% block content %}{% endblock %}
</main>
<script>
  // Auto-inject CSRF token from the shopdesk_csrf cookie into every HTML form.
  (function () {
    function getCookie(name) {
      for (const c of document.cookie.split(";")) {
        const [k, v] = c.trim().split("=");
        if (k === name) return decodeURIComponent(v || "");
      }
      return "";
    }
    const csrf = getCookie("shopdesk_csrf");
    if (!csrf) return;
    for (const f of document.querySelectorAll("form[method]")) {
      if (f.querySelector("input[name=_csrf]")) continue;
      const i = document.createElement("input");
      i.type = "hidden";
      i.name = "_csrf";
      i.value = csrf;
      f.appendChild(i);
    }
  })();
</script>
{% block extrascripts %}{% endblock %}
</body>
</html>
