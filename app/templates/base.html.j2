<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}ShopDesk — Modern Point of Sale{% endblock %}</title>
<link rel="stylesheet" href="/static/css/style.css">
<link rel="manifest" href="/static/manifest.webmanifest">
<link rel="icon" type="image/png" href="/static/icons/icon-192.png">
<script>
  // Instant theme hydration to avoid FOUC
  (function() {
    const savedTheme = localStorage.getItem('shopdesk_theme');
    if (savedTheme) {
      document.documentElement.setAttribute('data-theme', savedTheme);
    }
  })();
</script>
{% block extrahead %}{% endblock %}
</head>
<body>
<header>
  <div class="header-left">
    <a href="/pos" class="brand-wrapper">
      <div class="brand-icon-box">
        <svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
          <path d="M7 8h10"></path>
          <path d="M7 12h4"></path>
        </svg>
      </div>
      <strong>ShopDesk</strong>
    </a>
    <nav class="nav-links">
      <a href="/pos" class="nav-item {% if request.url.path == '/pos' %}active{% endif %}">
        <svg width="15" height="15" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        POS
      </a>
      <a href="/products" class="nav-item {% if request.url.path.startswith('/products') %}active{% endif %}">
        <svg width="15" height="15" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
        Products
      </a>
      <a href="/stock" class="nav-item {% if request.url.path.startswith('/stock') %}active{% endif %}">
        <svg width="15" height="15" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
        Stock
      </a>
      {% if user and user.role.value == 'owner' or not user %}
      <a href="/reports/daily" class="nav-item {% if request.url.path.startswith('/reports') %}active{% endif %}">
        <svg width="15" height="15" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        Reports
      </a>
      <a href="/settings" class="nav-item {% if request.url.path.startswith('/settings') %}active{% endif %}">
        <svg width="15" height="15" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        Settings
      </a>
      {% endif %}
    </nav>
  </div>

  <div class="header-right">
    <div id="network-pill" class="network-status" title="Connection status">
      <span class="network-dot"></span>
      <span id="network-label">Online</span>
    </div>
    
    <span id="pending-badge" class="badge pending-badge">Pending: 0</span>

    <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark/light mode" title="Switch Theme">
      <svg id="theme-icon-sun" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      <svg id="theme-icon-moon" width="16" height="16" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
    </button>

    {% if user %}
      <span class="user-badge">
        <svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        👤 {{ user.username }} ({{ user.role.value }})
      </span>
      <a href="/logout" class="btn secondary btn-sm">Logout</a>
    {% endif %}
  </div>
</header>

<main>
  {% block content %}{% endblock %}
</main>

<script>
  // Theme toggle handler
  (function() {
    const theme_btn = document.querySelector("#theme-toggle");
    const sun_icon = document.querySelector("#theme-icon-sun");
    const moon_icon = document.querySelector("#theme-icon-moon");

    function update_icons(is_dark) {
      if (sun_icon && moon_icon) {
        sun_icon.style.display = is_dark ? "block" : "none";
        moon_icon.style.display = is_dark ? "none" : "block";
      }
    }

    const current_theme = document.documentElement.getAttribute('data-theme') || 
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    update_icons(current_theme === 'dark');

    if (theme_btn) {
      theme_btn.addEventListener("click", () => {
        const is_current_dark = document.documentElement.getAttribute('data-theme') === 'dark' || 
          (!document.documentElement.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const next_theme = is_current_dark ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next_theme);
        localStorage.setItem('shopdesk_theme', next_theme);
        update_icons(next_theme === 'dark');
      });
    }

    // Network status listener
    const net_pill = document.querySelector("#network-pill");
    const net_label = document.querySelector("#network-label");
    function update_net() {
      if (navigator.onLine) {
        net_pill.classList.remove("offline");
        net_label.textContent = "Online";
      } else {
        net_pill.classList.add("offline");
        net_label.textContent = "Offline";
      }
    }
    window.addEventListener("online", update_net);
    window.addEventListener("offline", update_net);
    update_net();
  })();

  // Auto-inject CSRF token from the shopdesk_csrf cookie into every HTML form.
  (function () {
    function getCookie(name) {
      for (const c of document.cookie.split(";")) {
        const [k, v] = c.trim().split("=");
        if (k === name) return decodeURIComponent(v || "");
      }
      return "";
    }
    const csrf = getCookie("shopdesk_csrf");
    if (!csrf) return;
    for (const f of document.querySelectorAll("form[method]")) {
      if (f.querySelector("input[name=_csrf]")) continue;
      const i = document.createElement("input");
      i.type = "hidden";
      i.name = "_csrf";
      i.value = csrf;
      f.appendChild(i);
    }
  })();
</script>
{% block extrascripts %}{% endblock %}
</body>
</html>
